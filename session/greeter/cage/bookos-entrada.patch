+/* BookOS: cage deja libinput con sus valores de serie —touchpad lento, sin
+ * toque para hacer clic, scroll al revés— y mueve el cursor en píxeles de la
+ * salida, que corre a escala 1. La sesión de BookOS mueve en lógicos a escala
+ * 2 con velocidad 0,3: en la pantalla de acceso el puntero iba unas 2,5 veces
+ * más lento. Todo sale del entorno; sin variables, cage se porta como el de
+ * serie. */
+static double pointer_scale = 1.0;
+
+static void
+configure_libinput(struct wlr_input_device *device)
+{
+	if (!wlr_input_device_is_libinput(device)) {
+		return;
+	}
+	struct libinput_device *dev = wlr_libinput_get_device_handle(device);
+	bool touchpad = libinput_device_config_tap_get_finger_count(dev) > 0;
+
+	const char *speed = getenv(touchpad ? "CAGE_TOUCHPAD_SPEED" : "CAGE_MOUSE_SPEED");
+	if (speed && libinput_device_config_accel_is_available(dev)) {
+		libinput_device_config_accel_set_profile(dev, LIBINPUT_CONFIG_ACCEL_PROFILE_ADAPTIVE);
+		libinput_device_config_accel_set_speed(dev, strtod(speed, NULL));
+	}
+
+	const char *natural = getenv("CAGE_NATURAL_SCROLL");
+	if (natural && libinput_device_config_scroll_has_natural_scroll(dev)) {
+		libinput_device_config_scroll_set_natural_scroll_enabled(dev, strcmp(natural, "1") == 0);
+	}
+
+	if (!touchpad) {
+		return;
+	}
+	const char *tap = getenv("CAGE_TAP");
+	if (tap) {
+		libinput_device_config_tap_set_enabled(dev, strcmp(tap, "1") == 0 ? LIBINPUT_CONFIG_TAP_ENABLED
+										   : LIBINPUT_CONFIG_TAP_DISABLED);
+		/* Lo mismo que hace la sesión: clic con dedos en vez de zonas, que
+		 * en un clickpad sin botones convierte un clic abajo a la derecha en
+		 * botón derecho sin querer, y el puntero quieto mientras se escribe. */
+		libinput_device_config_click_set_method(dev, LIBINPUT_CONFIG_CLICK_METHOD_CLICKFINGER);
+		if (libinput_device_config_dwt_is_available(dev)) {
+			libinput_device_config_dwt_set_enabled(dev, LIBINPUT_CONFIG_DWT_ENABLED);
+		}
+	}
+}
