// La pantalla de acceso comparte tty1 con la sesión que acaba de cerrarse, que
// sigue registrada mientras le queden procesos (el 2026-10-17 bookos-settings y
// abrt-applet la tuvieron media hora en «closing»). Si logind la deja como
// activa del asiento, polkit trata al greeter como inactivo, exige contraseña
// de administrador y systemctl falla. No se ha comprobado qué sesión elige
// logind en ese caso; esta regla no depende de ello.
polkit.addRule(function(action, subject) {
    if (subject.user != "bookos-greeter" || !subject.local) {
        return polkit.Result.NOT_HANDLED;
    }
    var acciones = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.suspend",
        "org.freedesktop.login1.suspend-multiple-sessions",
        "org.freedesktop.login1.hibernate",
        "org.freedesktop.login1.hibernate-multiple-sessions",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.settings.modify.own",
        "net.hadess.PowerProfiles.switch-profile",
        "org.freedesktop.UPower.PowerProfiles.switch-profile",
        "org.freedesktop.locale1.set-locale",
        "org.freedesktop.locale1.set-keyboard",
    ];
    if (acciones.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
