#!/usr/bin/env bash
# Arranca BookOS como sesión de verdad, la que ofrece el gestor de login.
#
# Por qué existe además de `bookos-tty.sh`: aquel es para desarrollo —lleva un
# límite de tiempo, lanza un terminal de prueba y da por hecho que estás en un
# TTY—. Este es el que ejecuta SDDM cuando eliges "BookOS" en la lista de
# sesiones, y no puede hacer nada de eso.
#
# Se instala con `session/instalar.sh`, que necesita root para escribir en
# /usr/share/wayland-sessions.
set -u
# 022 y no 077. El 077 lo heredaban **todas** las aplicaciones de la sesión, y
# lo que escribieran nacía sin permiso de lectura para nadie más: los `.desktop`
# que se instalan desde dentro del escritorio quedaban en 600, así que el
# launchpad no los veía y en el registro salía «Error loading .desktop file …:
# permiso denegado». Lo que sí es privado —el registro y el directorio de la
# sesión— se protege abajo por su cuenta, que es donde toca.
umask 022

# Lo que anuncia la sesión al resto del sistema. `XDG_CURRENT_DESKTOP` es lo
# que miran los portales y las bibliotecas de toolkit para decidir cómo
# comportarse; sin él, GTK y Qt caen a sus valores genéricos.
export XDG_CURRENT_DESKTOP=BookOS
export XDG_SESSION_DESKTOP=BookOS
export XDG_SESSION_TYPE=wayland

# Qt y GTK a Wayland nativo. Sin esto, las aplicaciones Qt entran por XWayland
# aunque haya un compositor Wayland delante, y se ven borrosas a escala
# fraccionaria.
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland,x11
export MOZ_ENABLE_WAYLAND=1

# Cursores. Sin XCURSOR_THEME el compositor cae a "BookOS-Dark", que es un tema
# de ICONOS: bookos-icons instala apps y lugares, no cursores, así que salía la
# flecha de reserva y encima cada aplicación elegía el suyo por su cuenta. Se
# coge el primero que esté instalado de verdad y se exporta para toda la sesión,
# compositor y clientes. BookOS-Dark se mira primero por si algún día los trae.
if [ -z "${XCURSOR_THEME:-}" ]; then
    for tema in BookOS-Dark breeze_cursors Breeze_Light Adwaita; do
        for base in "$HOME/.local/share/icons" /usr/share/icons; do
            if [ -d "$base/$tema/cursors" ]; then
                export XCURSOR_THEME="$tema"
                break 2
            fi
        done
    done
fi
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# El binario: primero el instalado, y si no, el del árbol de desarrollo.
#
# Entre `release` y `debug` gana **el más reciente**, no `release` por delante
# como antes. Ese orden fijo era una trampa: `cargo run` y `cargo build`
# compilan en `debug`, así que quien tocaba el código y se iba al TTY seguía
# arrancando el `release` de la última vez y probaba una versión vieja sin
# enterarse. Costó una tarde de "esto no funciona" que sí funcionaba.
# Dos rutas instaladas: /usr/local/bin es la de session/instalar.sh (desarrollo)
# y /usr/libexec la del RPM. Se miran las dos: mirando solo la primera, con el
# paquete instalado no se encontraba el compositor y la sesión moría al entrar.
binario=""
for instalado in /usr/local/bin/bookos-comp /usr/libexec/bookos-comp; do
    [ -x "$instalado" ] && { binario="$instalado"; break; }
done
if [ ! -x "$binario" ]; then
    raiz="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
    binario=""
    for candidato in "$raiz/target/release/bookos-comp" "$raiz/target/debug/bookos-comp"; do
        [ -x "$candidato" ] || continue
        if [ -z "$binario" ] || [ "$candidato" -nt "$binario" ]; then
            binario="$candidato"
        fi
    done
fi

recuperacion="$(dirname "$(readlink -f "$0")")/bookos-recovery.py"
for candidato in "$recuperacion" /usr/local/libexec/bookos-recovery.py /usr/libexec/bookos-recovery.py; do
    if [ -f "$candidato" ]; then recuperacion="$candidato"; break; fi
done
if [ ! -x "$binario" ]; then
    echo "no encuentro bookos-comp" >&2
    exit 1
fi

# El servicio compartido se activa por D-Bus cuando hace falta, pero el gestor
# de usuario puede no haber recargado todavía la unidad recién instalada.
# Recargarla y arrancarla aquí evita que el primer widget vea un estado vacío y
# también permite que systemd la reinicie si NetworkManager, BlueZ o PipeWire
# aparecen después de la sesión.
systemctl --user daemon-reload >/dev/null 2>&1 || true
systemctl --user start bookos-system.service >/dev/null 2>&1 || true

# El registro va a un fichero y no a la salida estándar porque SDDM se la come:
# cuando la sesión no arranca, esto es lo único que queda para saber por qué.
registro="${XDG_RUNTIME_DIR:-/tmp}/bookos-session.log"
# El registro lleva la salida de todo lo que corre en la sesión y puede acabar
# con cualquier cosa dentro, así que es del usuario y de nadie más. Se crea
# vacío y se le quitan los permisos **antes** de escribir nada, que si no hay
# una ventana en la que existe abierto de par en par.
: >"$registro" && chmod 600 "$registro"
# Qué binario y de cuándo, lo primero de todo: es la línea que contesta a "¿por
# qué no veo el cambio que acabo de hacer?".
{
    echo "bookos-session: $binario"
    echo "compilado: $(date -r "$binario" '+%d/%m %H:%M' 2>/dev/null || echo '?')"
} >"$registro"

# ── Autoarranque XDG ───────────────────────────────────────────────────────
# Lanzar lo de /etc/xdg/autostart y ~/.config/autostart es cosa del escritorio.
# Plasma lo hace y BookOS cuenta con ello: por ahí salen el refresco de primer
# inicio y la ventana de novedades. El compositor no lo implementa, así que se
# hace aquí, que es donde está el ciclo de vida de la sesión.
#
# Del estándar se respeta lo que decide si una entrada corre o no: Hidden,
# OnlyShowIn/NotShowIn contra el nombre de esta sesión, y TryExec. De Exec se
# quitan los códigos %f %u %U… , que solo tienen sentido al abrir ficheros.
lanzar_autostart() {
    local vistos=" " entrada nombre valor orden
    for dir in "${XDG_CONFIG_HOME:-$HOME/.config}/autostart" /etc/xdg/autostart; do
        [ -d "$dir" ] || continue
        for entrada in "$dir"/*.desktop; do
            [ -f "$entrada" ] || continue
            nombre=$(basename "$entrada")
            # El del usuario gana sobre el del sistema con el mismo nombre.
            case "$vistos" in *" $nombre "*) continue ;; esac
            vistos="$vistos$nombre "
            [ "$(sed -n 's/^Hidden=//p' "$entrada" | head -n1)" = true ] && continue
            valor=$(sed -n 's/^OnlyShowIn=//p' "$entrada" | head -n1)
            if [ -n "$valor" ]; then
                case ";$valor" in *";BookOS;"*) ;; *) continue ;; esac
            fi
            valor=$(sed -n 's/^NotShowIn=//p' "$entrada" | head -n1)
            if [ -n "$valor" ]; then
                case ";$valor" in *";BookOS;"*) continue ;; esac
            fi
            valor=$(sed -n 's/^TryExec=//p' "$entrada" | head -n1)
            if [ -n "$valor" ] && ! command -v "$valor" >/dev/null 2>&1; then
                continue
            fi
            orden=$(sed -n 's/^Exec=//p' "$entrada" | head -n1)
            [ -n "$orden" ] || continue
            orden=$(printf '%s' "$orden" | sed 's/%[fFuUdDnNickvm]//g')
            echo "autostart: $nombre" >>"$registro"
            setsid sh -c "$orden" >>"$registro" 2>&1 &
        done
    done
}

# El compositor va en segundo plano, no con exec, para poder lanzar el
# autoarranque cuando su socket ya existe: sin WAYLAND_DISPLAY apuntando a él,
# lo que se lance no tiene a qué conectarse.
sesion_tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/bookos-session.XXXXXXXX") || exit 1
export BOOKOS_SESSION_SOCKET_FILE="$sesion_tmp/socket"
export BOOKOS_SESSION_LOCK_FILE="$sesion_tmp/unlocked"
comp=""
sonido_login=false
finalizar() {
    trap - TERM INT HUP
    if [ -n "$comp" ]; then kill "$comp" 2>/dev/null || true; wait "$comp" 2>/dev/null || true; fi
    exit 0
}
trap finalizar TERM INT HUP
# Parar el target al salir se lleva por delante el portal y bookos-system, que
# cuelgan de `graphical-session.target`. Sin esto quedarían corriendo contra un
# compositor que ya no está, y la siguiente sesión encontraría un portal con el
# entorno de la anterior.
trap 'systemctl --user stop bookos-session.target >/dev/null 2>&1 || true; rm -f "$BOOKOS_SESSION_SOCKET_FILE" "$BOOKOS_SESSION_LOCK_FILE"; rmdir "$sesion_tmp" 2>/dev/null || true' EXIT
while true; do
    # Un reinicio desde la recuperación ha sido solicitado explícitamente.
    printf unlocked >"$BOOKOS_SESSION_LOCK_FILE"
    rm -f "$BOOKOS_SESSION_SOCKET_FILE"
    # Una sesión real no debe convertirse en anidada al reutilizar su entorno.
    unset WAYLAND_DISPLAY DISPLAY
    "$binario" >>"$registro" 2>&1 &
    comp=$!
    socket=""
    for _ in $(seq 100); do
        kill -0 "$comp" 2>/dev/null || break
        if [ -s "$BOOKOS_SESSION_SOCKET_FILE" ]; then
            read -r socket <"$BOOKOS_SESSION_SOCKET_FILE" || true
            [ -S "${XDG_RUNTIME_DIR:-/tmp}/$socket" ] && break
        fi
        sleep 0.05
    done
    if [ -n "$socket" ] && kill -0 "$comp" 2>/dev/null; then
        export WAYLAND_DISPLAY="$socket"

        # Los servicios D-Bus de usuario nacieron antes que el compositor y no
        # heredan las variables que acabamos de fijar en este proceso. En
        # particular xdg-desktop-portal necesita saber que está en BookOS para
        # elegir BookOS-portals.conf; con el entorno viejo escogía el backend
        # genérico y las aplicaciones recibían el esquema claro aunque el
        # escritorio estuviera oscuro.
        if command -v dbus-update-activation-environment >/dev/null 2>&1; then
            dbus-update-activation-environment --systemd \
                WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
                XDG_SESSION_TYPE QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND \
                XCURSOR_THEME XCURSOR_SIZE >/dev/null 2>&1 || true
        else
            systemctl --user import-environment \
                WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
                XDG_SESSION_TYPE QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND \
                XCURSOR_THEME XCURSOR_SIZE >/dev/null 2>&1 || true
        fi
        # Y ahora sí se declara la sesión gráfica, **después** de meter el
        # entorno en el bus: lo que arranque a partir de aquí ya nace sabiendo
        # que está en BookOS y con qué socket de Wayland hablar.
        #
        # Esta línea es la que hace que haya portal. `xdg-desktop-portal.service`
        # lleva `Requisite=graphical-session.target` y sin el target activo su
        # trabajo falla nada más pedirlo, así que hasta ahora ninguna aplicación
        # recibía el `color-scheme` oscuro, no había diálogo de abrir fichero y
        # compartir pantalla no funcionaba. Ver `bookos-session.target`.
        systemctl --user start bookos-session.target >/dev/null 2>&1 || true
        # Si el portal venía vivo de otra sesión, que relea el escritorio y
        # la selección de backend. `try-restart` no arranca nada si aún no se
        # había usado; el arranque de verdad lo hace el target de arriba.
        systemctl --user try-restart xdg-desktop-portal.service >/dev/null 2>&1 || true
        lanzar_autostart
        # La recuperación puede relanzar el compositor dentro de esta misma
        # sesión. El sonido marca el login, no cada reinicio tras un fallo.
        if [ "$sonido_login" = false ] && command -v canberra-gtk-play >/dev/null 2>&1; then
            canberra-gtk-play -i desktop-login >/dev/null 2>&1 &
            sonido_login=true
        fi
    fi
    wait "$comp"
    codigo=$?
    comp=""
    # Cerrar sesión, apagar y Ctrl+Alt+Retroceso no son fallos.
    [ "$codigo" -eq 0 ] && exit 0
    estado_dir="${XDG_STATE_HOME:-$HOME/.local/state}/bookos"
    mkdir -p "$estado_dir"
    error_log="$estado_dir/compositor-last-crash.log"
    cp "$registro" "$error_log" || error_log="$registro"
    echo "bookos-session: el compositor terminó con código $codigo" >>"$error_log"
    bloqueo=()
    if [ "$codigo" -eq 77 ] || [ ! -f "$BOOKOS_SESSION_LOCK_FILE" ]; then
        bloqueo=(--locked)
    fi
    unset WAYLAND_DISPLAY DISPLAY
    if [ -f "$recuperacion" ] && command -v python3 >/dev/null 2>&1; then
        python3 "$recuperacion" --status "$codigo" --log "$error_log" "${bloqueo[@]}" >>"$registro" 2>&1
        respuesta=$?
        [ "$respuesta" -eq 10 ] && continue
    fi
    exit 0
done
